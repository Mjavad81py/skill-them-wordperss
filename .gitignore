# Dependencies
node_modules/
vendor/

# Build scratch space. Packaged releases live in release/ and ARE tracked, so the
# theme and plugin zips can be downloaded straight from the repository.
build/
dist/
*.zip
!skill-themp-wordpress.zip
!release/*.zip

# Local config and environment
.env
.env.*
wp-config-local.php
*.local.php

# Editors and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Logs and caches
*.log
debug.log
.cache/
.phpunit.result.cache
.php-cs-fixer.cache

# Compiled translations (regenerate with wp i18n make-mo)
*.mo
